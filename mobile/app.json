{
  "expo": {
    "name": "MemoryPal",
    "slug": "memorypal",
    "scheme": "memorypal",
    "version": "0.48.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://wgfaryxbwritolayuydh.supabase.co",
      "supabasePublishableKey": "sb_publishable_2dZ7rq2PQ9oCMG7bMMWhUQ_am1Zh1E6",
      "termsUrl": "https://github.com/TKSMG/MemoryPal/blob/main/TERMS_OF_USE.md",
      "privacyUrl": "https://github.com/TKSMG/MemoryPal/blob/main/PRIVACY_POLICY.md"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.memorypal.mobile",
      "buildNumber": "50",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.memorypal.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#3451db",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 50,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "MemoryPal"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#f6f8fc",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#111827"
          }
        }
      ],
      "expo-font",
      "expo-secure-store"
    ]
  }
}
